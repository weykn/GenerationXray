{
	"schemaVersion": 1,
	"id": "seedxray",
	"version": "${version}",
	"name": "Seed X-Ray",
	"description": "Client-side x-ray that finds ores by regenerating chunks from the world seed, then draws them through terrain.",
	"authors": [
		"weykn",
		"CasioWatch123"
	],
	"contact": {
		"homepage": "https://github.com/weykn/GenerationXray",
		"sources": "https://github.com/weykn/GenerationXray",
		"issues": "https://github.com/weykn/GenerationXray/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/seedxray/icon.png",
	"environment": "*",
	"entrypoints": {
        "modmenu": [
          "com.seedxray.config.ModMenuEntrypoint"
        ],
		"main": [
		],
		"client": [
			"com.seedxray.SeedXRayClient"
		]
	},
	"accessWidener": "seedxray.accesswidener",
	"mixins": [
		"seedxray.mixins.json",
		{
			"config": "seedxray.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
        "vchunklib": "=${vchunklib_version}",
        "modmenu": ">=20.0.0",
        "cloth-config": ">=26.2.155"
	}
}